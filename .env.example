# Public client configuration only. Never put server/database/admin secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_PROTOCOL_VERSION=1

# API service secrets belong in a private server environment, not the mobile bundle.
DATABASE_URL=
REDIS_URL=
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_ISSUER=
SUPABASE_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
INVITE_CODE_SECRET=
OPS_ADMIN_USER_IDS=
PUBLIC_SUPPORT_EMAIL=
DATABASE_SSL=require
DATABASE_SSL_CA_FILE=.local/supabase-root-ca.crt
PORT=8080
HOST=0.0.0.0
