{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["movematch", "pose"],
  "ios": { "iosModuleName": "MoveMatchPoseTracker" },
  "android": {
    "androidNamespace": ["movematch", "pose"],
    "androidCxxLibName": "MoveMatchPoseTracker"
  },
  "autolinking": {
    "PoseLandmarker": {
      "ios": { "language": "swift", "implementationClassName": "HybridPoseLandmarker" },
      "android": { "language": "kotlin", "implementationClassName": "HybridPoseLandmarker" }
    }
  },
  "ignorePaths": ["node_modules", "build"]
}
